# Copie este arquivo para ".env" (mesma pasta) e preencha com os
# dados reais do banco. O ".env" nunca deve ser enviado ao Git —
# ele já está no .gitignore do projeto.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASS=senha_do_banco

# Criptografa (TLS) a conexão com o banco. Deixe em 1 (padrão);
# só mude pra 0 se a hospedagem do banco não suportar SSL e a
# conexão começar a falhar por causa disso.
DB_SSL=1

# Login com Google (OAuth 2.0)
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# Tipo: "OAuth client ID" > "Web application"
# A URI de redirecionamento deve apontar para /auth/callback.php
# no domínio deste ambiente e estar cadastrada no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8099/auth/callback.php
